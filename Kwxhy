local function aplicarAbafadorGlobal()
    if abafadorAtivo then
        if not soundService:FindFirstChild("12kxhy_MuffleEQ") then
            local globalEq = Instance.new("EqualizerSoundEffect")
            globalEq.Name = "12kxhy_MuffleEQ"
            globalEq.HighGain = -35
            globalEq.MidGain = -12
            globalEq.LowGain = 8
            globalEq.Priority = 999
            globalEq.Parent = soundService
        end

        if not soundService:FindFirstChild("12kxhy_MuffleFilter") then
            local globalFilter = Instance.new("PitchShiftSoundEffect")
            globalFilter.Name = "12kxhy_MuffleFilter"
            globalFilter.Pitch = 0.85
            globalFilter.Parent = soundService
        end

        for _, sound in pairs(workspaceService:GetDescendants()) do
            if sound:IsA("Sound") and not sound:FindFirstChild("LocalEQ") then
                local eq = Instance.new("EqualizerSoundEffect")
                eq.Name = "LocalEQ"
                eq.HighGain = -30
                eq.MidGain = -10
                eq.LowGain = 5
                eq.Parent = sound
            end
        end
    else
        local eq = soundService:FindFirstChild("12kxhy_MuffleEQ")
        if eq then eq:Destroy() end

        local filter = soundService:FindFirstChild("12kxhy_MuffleFilter")
        if filter then filter:Destroy() end

        for _, sound in pairs(workspaceService:GetDescendants()) do
            if sound:IsA("Sound") then
                local localEq = sound:FindFirstChild("LocalEQ")
                if localEq then localEq:Destroy() end
            end
        end
    end
end

workspaceService.DescendantAdded:Connect(function(obj)
    if abafadorAtivo and obj:IsA("Sound") then
        task.wait(0.05)
        if not obj:FindFirstChild("LocalEQ") then
            local eq = Instance.new("EqualizerSoundEffect")
            eq.Name = "LocalEQ"
            eq.HighGain = -30
            eq.MidGain = -10
            eq.LowGain = 5
            eq.Parent = obj
        end
    end
end)

