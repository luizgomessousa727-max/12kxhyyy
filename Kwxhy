local function atualizarBotao(ativo, btnFrame, stroke, toggleBg, toggleDot)
    local targetBg = ativo and Color3.fromRGB(220, 45, 60) or Color3.fromRGB(40, 46, 56)
    local targetDotPos = ativo and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    local targetDotColor = ativo and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 165, 175)
    local targetStroke = ativo and Color3.fromRGB(255, 80, 95) or Color3.fromRGB(38, 44, 54)

    tweenService:Create(toggleBg, tweenFast, {BackgroundColor3 = targetBg}):Play()
    tweenService:Create(toggleDot, tweenFast, {Position = targetDotPos, BackgroundColor3 = targetDotColor}):Play()
    tweenService:Create(stroke, tweenFast, {Color = targetStroke}):Play()
end

