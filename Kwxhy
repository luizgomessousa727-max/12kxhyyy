-- 9. OLD SHIFT LOCK
-- ==============================================
local conexaoShift = nil
local isShiftLocked = false
local shiftOffset = Vector3.new(0.9, 1.1, 0)
local normalOffset = Vector3.new(0, 0, 0)

local function desativarShift()
    if conexaoShift then
        conexaoShift:Disconnect()
        conexaoShift = nil
    end
    isShiftLocked = false
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.CameraOffset = normalOffset
    end
end

local function ativarShift()
    desativarShift()
    conexaoShift = runService.RenderStepped:Connect(function()
        if not shiftAtivo then return end
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then return end
        local humanoid = player.Character.Humanoid

        if userInput.MouseBehavior == Enum.MouseBehavior.LockCenter then
            if not isShiftLocked then
                isShiftLocked = true
                humanoid.CameraOffset = shiftOffset
            end
        else
            if isShiftLocked then
                isShiftLocked = false
                humanoid.CameraOffset = normalOffset
            end
        end
    end)
end

