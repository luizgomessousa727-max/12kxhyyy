-- 3. SPIN SPEED SYSTEM
-- ==============================================
local lastCameraCFrame = workspaceService.CurrentCamera.CFrame
local normalSpeed = 16
local boostedSpeed = 150

runService.RenderStepped:Connect(function()
    if not spinSpeedAtivo then return end
    
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local cam = workspaceService.CurrentCamera
    if not cam then return end

    local estaEscalando = (hum:GetState() == Enum.HumanoidStateType.Climbing)
    local temToolEquipada = (char:FindFirstChildOfClass("Tool") ~= nil)

    local currentCFrame = cam.CFrame
    local angleChange = math.abs((currentCFrame.LookVector - lastCameraCFrame.LookVector).Magnitude)
    lastCameraCFrame = currentCFrame

    if angleChange > 0.08 and estaEscalando and temToolEquipada then
        hum.WalkSpeed = boostedSpeed
    else
        hum.WalkSpeed = normalSpeed
    end
end)

